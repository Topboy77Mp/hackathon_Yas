# Adresse de l'API.
#
# ATTENTION : sur un téléphone, « localhost » désigne le téléphone lui-même.
# Une application compilée en APK avec localhost ne joint jamais l'API.
#
# - Cible web (npx expo start --web) : localhost convient.
# - Expo Go / build de développement : laisser vide, l'adresse est déduite
#   automatiquement de l'hôte Metro auquel l'application est déjà connectée.
# - APK autonome : OBLIGATOIRE. Mettre l'IP de la machine sur le réseau local
#   (ex. http://10.221.64.99:8000) ou l'URL de l'API déployée.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Jeton de démonstration, à faire correspondre au DEMO_TOKEN du backend.
# Utilisé uniquement par l'écran « mot de passe oublié » : aucune passerelle SMS
# n'est au périmètre du contrat, donc sans ce jeton le code ne peut arriver
# nulle part. Laisser VIDE en production.
EXPO_PUBLIC_DEMO_TOKEN=jokkoo-demo
