# Backend
DATABASE_URL=postgresql://kashflow:kashflow@localhost:5432/kashflow
JWT_SECRET=change-moi-avant-le-deploiement
JWT_EXPIRE_MINUTES=1440

# IA — Groq, clé serveur uniquement, ne doit jamais atteindre le front.
# Absente, l'application tourne intégralement en fallback déterministe.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Endpoint de simulation de la demo, protege par ce token
DEMO_TOKEN=jokkoo-demo

# Fronts
EXPO_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
